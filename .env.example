# Copy to .env (scripts/setup.sh does this). .env is git-ignored: never commit real keys.

# Required with the default config/models.yaml
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Only if you point a role at gemini/... directly in config/models.yaml
GEMINI_API_KEY=

# Optional: tracing with Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Optional: answer gates on Telegram (token from @BotFather, then `r2r telegram chat-id`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: answer gates on WhatsApp through Meta's Cloud API (built, not yet tested live)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OWNER_NUMBER=
PUBLIC_WEBHOOK_URL=
